root = true

[*]
charset = utf-8
end_of_line = crlf
insert_final_newline = true
indent_style = space
trim_trailing_whitespace = true

[*.{yaml,yml,json,js,css,html}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false   # two trailing spaces is a markdown line break

[*.cs]
indent_size = 4

# ── Naming ────────────────────────────────────────────────────────────────────
# These exist because naming was being reviewed by eye and things got through.
# What a tool can check, a tool should check.

dotnet_diagnostic.IDE1006.severity = warning   # naming rule violations, below

dotnet_naming_style.pascal_case.capitalization = pascal_case
dotnet_naming_style.camel_case.capitalization  = camel_case

dotnet_naming_style.underscore_camel_case.capitalization    = camel_case
dotnet_naming_style.underscore_camel_case.required_prefix   = _

dotnet_naming_style.interface_prefix.capitalization  = pascal_case
dotnet_naming_style.interface_prefix.required_prefix = I

dotnet_naming_symbols.types.applicable_kinds = class, struct, enum, delegate
dotnet_naming_rule.types_are_pascal_case.symbols  = types
dotnet_naming_rule.types_are_pascal_case.style    = pascal_case
dotnet_naming_rule.types_are_pascal_case.severity = warning

dotnet_naming_symbols.interfaces.applicable_kinds = interface
dotnet_naming_rule.interfaces_start_with_i.symbols  = interfaces
dotnet_naming_rule.interfaces_start_with_i.style    = interface_prefix
dotnet_naming_rule.interfaces_start_with_i.severity = warning

dotnet_naming_symbols.members.applicable_kinds = method, property, event, namespace
dotnet_naming_rule.members_are_pascal_case.symbols  = members
dotnet_naming_rule.members_are_pascal_case.style    = pascal_case
dotnet_naming_rule.members_are_pascal_case.severity = warning

# required_modifiers is an AND, so "const, static readonly" matches nothing at all — it needs a
# field that is const *and* static *and* readonly. Two rules, and both must come before the
# instance-field rule below, because the first matching rule wins.
dotnet_naming_symbols.constants.applicable_kinds   = field
dotnet_naming_symbols.constants.required_modifiers = const
dotnet_naming_rule.constants_are_pascal_case.symbols  = constants
dotnet_naming_rule.constants_are_pascal_case.style    = pascal_case
dotnet_naming_rule.constants_are_pascal_case.severity = warning

dotnet_naming_symbols.static_readonly_fields.applicable_kinds   = field
dotnet_naming_symbols.static_readonly_fields.required_modifiers = static, readonly
dotnet_naming_rule.static_readonly_is_pascal_case.symbols  = static_readonly_fields
dotnet_naming_rule.static_readonly_is_pascal_case.style    = pascal_case
dotnet_naming_rule.static_readonly_is_pascal_case.severity = warning

# Instance fields only — a static readonly field reads as a constant and is named like one.
dotnet_naming_symbols.private_fields.applicable_kinds           = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private
dotnet_naming_rule.private_fields_have_underscore.symbols  = private_fields
dotnet_naming_rule.private_fields_have_underscore.style    = underscore_camel_case
dotnet_naming_rule.private_fields_have_underscore.severity = warning

dotnet_naming_symbols.locals.applicable_kinds = parameter, local
dotnet_naming_rule.locals_are_camel_case.symbols  = locals
dotnet_naming_rule.locals_are_camel_case.style    = camel_case
dotnet_naming_rule.locals_are_camel_case.severity = warning

# ── Public API hygiene ────────────────────────────────────────────────────────
dotnet_diagnostic.CA1707.severity = warning   # no underscores in identifiers
dotnet_diagnostic.CA1708.severity = warning   # names that differ only by case
dotnet_diagnostic.CA1725.severity = warning   # parameter names match the base declaration
dotnet_diagnostic.CA1711.severity = warning   # no misleading type-name suffixes

# Errors, not warnings: a warning in a 200-file build is a warning nobody reads.
dotnet_diagnostic.CS8618.severity = error     # non-nullable field left uninitialised
dotnet_diagnostic.CS8602.severity = error     # dereference of a possibly-null value
