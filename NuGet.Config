<?xml version="1.0" encoding="utf-8"?>
<!-- Pins package restore to nuget.org regardless of what the machine's own global NuGet config
     points at (a private feed, a disabled source, one that needs credentials). Without this, a
     clone onto a machine set up for other .NET work can fail to restore YamlDotNet on the very
     first `dotnet run` — which the README promises just works with nothing to configure. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
